<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.todo.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.todo.model.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUsername" resultMap="UserResultMap">
        SELECT id, username, password, created_at
        FROM "user"
        WHERE username = #{username}
    </select>

    <select id="findById" resultMap="UserResultMap">
        SELECT id, username, password, created_at
        FROM "user"
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.todo.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO "user" (username, password, created_at)
        VALUES (#{username}, #{password}, #{createdAt})
    </insert>

    <update id="update" parameterType="com.todo.model.User">
        UPDATE "user"
        SET username = #{username},
            password = #{password}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM "user"
        WHERE id = #{id}
    </delete>

</mapper>